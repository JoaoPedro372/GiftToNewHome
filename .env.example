# Mercado Pago (server only — never expose to the client)
# Dashboard → Suas integrações → Credenciais de teste / produção
# Test tokens usually start with TEST-  |  Production with APP_USR-
MP_ACCESS_TOKEN=TEST-xxxxxxxx
# Dashboard → Webhooks → secret signature (optional in local dev)
MP_WEBHOOK_SECRET=your_webhook_secret

# Public app URL used for Mercado Pago notification_url
# Local: http://localhost:8080  |  Production: https://seu-projeto.vercel.app
APP_URL=http://localhost:8080

# Supabase
# 1) Create a project
# 2) Run supabase/schema.sql in the SQL editor
# 3) Project Settings → API → URL + secret / service_role key
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_key
